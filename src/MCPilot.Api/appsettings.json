{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MCPilot": "Information"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-opus-5",
    "MaxTokens": 16000,
    "Effort": "high",
    "EnableThinking": true,
    "ShowThinking": false
  },

  "Chat": {
    "MaxToolIterations": 8,
    "MaxHistoryMessages": 40,
    "MaxToolResultChars": 20000
  },

  "ToolPolicy": {
    "Mode": "Auto",
    "Allowed": [],
    "Denied": [],
    "MaxToolCallsPerRequest": 20
  },

  "Mcp": {
    "ToolNameSeparator": "__",
    "ConnectTimeoutSeconds": 30,
    "ToolCallTimeoutSeconds": 120,
    "Servers": [
      {
        "Name": "db",
        "Enabled": true,
        "Transport": "Stdio",
        "Command": "dotnet",
        "Arguments": [ "../MCPilot.Mcp.Database/bin/Debug/net8.0/MCPilot.Mcp.Database.dll" ],
        "Environment": {
          "MCPILOT_DB_CONNECTION": ""
        }
      }
    ]
  }
}
