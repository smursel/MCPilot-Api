          "profit": {
            "type": "number",
            "format": "double"
          },
          "profitChange": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "orders": {
            "type": "integer",
            "format": "int32"
          },
          "ordersChange": {
            "type": "number",
