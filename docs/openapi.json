      "get": {
        "tags": [
          "Tool"
        ],
        "summary": "Bagli MCP sunucularinda kesfedilen tum araclari listeler.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ToolDescriptor"
                  }
                }
              }
